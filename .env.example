### ---------------------------------------------------------------------------
### Sarvam AI credentials  (get a key at https://dashboard.sarvam.ai -> API Keys)
### ---------------------------------------------------------------------------
SARVAM_API_KEY=sk_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SARVAM_BASE_URL=https://api.sarvam.ai

### Models (see docs.sarvam.ai/api/getting-started/models)
STT_MODEL=saaras:v3
TTS_MODEL=bulbul:v3
LLM_MODEL=sarvam-105b
TRANSLATE_MODEL=mayura:v1

### ---------------------------------------------------------------------------
### Database
### ---------------------------------------------------------------------------
# SQLite (default, zero setup). Swap for Postgres with NO code change, e.g.
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/emi_agent
DATABASE_URL=sqlite+pysqlite:///./data/emi_agent.db

### ---------------------------------------------------------------------------
### Voice-loop tuning  (see docs/architecture.md section "latency budget")
### ---------------------------------------------------------------------------
# ws  = stream Bulbul over WebSocket, mp3 chunks  (~234 ms time-to-first-audio)
# rest = one REST call per sentence, wav          (more portable, slower TTFA)
TTS_TRANSPORT=ws
# Disable sarvam-105b's reasoning pass: reasoning tokens add ~2-4 s to TTFT,
# which is fatal for a voice turn. null | low | medium | high
LLM_REASONING_EFFORT=null
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=300
# Barge-in guards against backchannel ("haan", "hmm") and line noise.
BARGE_IN_MIN_SPEECH_MS=280
# Reprompt instead of acting when Saaras is unsure of the language.
STT_MIN_LANGUAGE_CONFIDENCE=0.55
# Saaras splits one spoken utterance into several finals. Wait this long for a
# follow-on fragment before replying, so the bot answers the whole sentence.
STT_COALESCE_MS=250

### ---------------------------------------------------------------------------
### Compliance (RBI recovery-agent norms / DPDP Act 2023)
### ---------------------------------------------------------------------------
CALLING_WINDOW_START=08:00
CALLING_WINDOW_END=19:00
CALLING_WINDOW_TZ=Asia/Kolkata
# Refuse to start a call outside the window. Set false only for demos.
ENFORCE_CALLING_WINDOW=true
# Redact phone numbers / loan ids from application logs.
REDACT_PII_IN_LOGS=true

### ---------------------------------------------------------------------------
### Downstream systems. Mocked in the PoC; each is one adapter swap in
### src/app/orchestrator/ to point at the real endpoint.
### ---------------------------------------------------------------------------
PAYMENT_GATEWAY_BASE=mock://payments
CRM_BASE=mock://lms
WHATSAPP_BASE=mock://whatsapp
RECORDING_SINK=file://./data/recordings
# Real S3 in production: s3://your-bucket-col/recordings

### ---------------------------------------------------------------------------
### Optional: real telephony (see docs/telephony.md). Leave blank for the
### browser-mic demo.
### ---------------------------------------------------------------------------
TELEPHONY_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=

### ---------------------------------------------------------------------------
### Server
### ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Write every stage transition to logs/steps.jsonl for the demo walkthrough.
STEP_LOG_PATH=./logs/steps.jsonl
